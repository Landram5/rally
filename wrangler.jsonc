{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rally-table-tennis",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {"pattern": "rallytt.net/*", "zone_name": "rallytt.net"},
    {"pattern": "www.rallytt.net/*", "zone_name": "rallytt.net"}
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rally-table-tennis",
      "database_id": "37cea1e3-87b5-41dc-9c2a-bcea2514b2c4",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {"enabled": true},
  "triggers": {"crons": ["*/5 * * * *"]}
}
