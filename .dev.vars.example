SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
RALLY_ADMIN_EMAILS=admin@example.com
# Server-only secret for account deletion. Never add this to browser/iOS code.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Turnstile: public site key; secret stays server-side. Supabase Auth CAPTCHA must use this widget.
TURNSTILE_SITE_KEY=your-public-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret

# Optional notification delivery. Both channels default to off in user settings.
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_FROM=Rally <notifications@rallytt.net>
VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_SUBJECT=mailto:notifications@rallytt.net
